{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.cjs" },
    { "source": "/attachment", "destination": "/api/index.cjs" },
    { "source": "/correction-file", "destination": "/api/index.cjs" },
    { "source": "/preview/:path*", "destination": "/api/index.cjs" }
  ],
  "functions": { "api/index.cjs": { "maxDuration": 60 } }
}
