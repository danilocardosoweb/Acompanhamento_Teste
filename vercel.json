{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/index.cjs", "use": "@vercel/node", "config": { "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs" } },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "vendor/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/.*", "dest": "/api/index.cjs" },
    { "src": "/attachment", "dest": "/api/index.cjs" },
    { "src": "/correction-file", "dest": "/api/index.cjs" },
    { "src": "/tool-drawing", "dest": "/api/index.cjs" },
    { "src": "/preview/.*", "dest": "/api/index.cjs" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
